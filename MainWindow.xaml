<Window x:Class="ClaudePulse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClaudePulse"
        Width="380" MaxHeight="560" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        ShowActivated="True">

    <Border Background="{StaticResource PanelBg}" CornerRadius="12"
            BorderBrush="#FF3A3A4A" BorderThickness="1" Padding="12"
            MouseLeftButtonDown="OnDragMove">
        <DockPanel>

            <!-- Header -->
            <DockPanel DockPanel.Dock="Top" Margin="4,0,0,10">
                <TextBlock Text="ClaudePulse" FontSize="15" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveSetButton" Content="&#x1F4BE;" FontSize="12"
                            Width="26" Height="24" Margin="0,0,4,0" Click="OnSaveSetClick"
                            ToolTip="Remember the current CLI sessions as a set"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}" Cursor="Hand"/>
                    <Button x:Name="LaunchSetButton" Content="&#x25B6;" FontSize="11" Visibility="Collapsed"
                            Width="26" Height="24" Margin="0,0,4,0" Click="OnLaunchSetClick"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource AccentIdle}" Cursor="Hand"/>
                    <Button x:Name="RestoreButton" Visibility="Collapsed" Click="OnRestoreClick"
                            Content="&#x21BB; Restore" FontSize="11" Height="24" Padding="8,0"
                            Margin="0,0,6,0" Cursor="Hand" BorderThickness="0"
                            ToolTip="Reopen sessions that were running before shutdown — one Windows Terminal tab each, resuming the same conversation"
                            Background="#FF2E4A3A" Foreground="{StaticResource AccentIdle}"/>
                    <ToggleButton x:Name="PinButton" Content="&#x1F4CC;" FontSize="12"
                                  Width="26" Height="24" Margin="0,0,4,0" IsChecked="True"
                                  ToolTip="Pinned: panel stays open. Unpin to auto-hide when it loses focus."
                                  Background="Transparent" BorderThickness="0"
                                  Foreground="{StaticResource TextSecondary}" Cursor="Hand"/>
                    <Button Content="&#x2715;" FontSize="11" Width="26" Height="24"
                            Click="OnHideClick" ToolTip="Hide (Ctrl+Alt+C to reopen)"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{StaticResource TextSecondary}" Cursor="Hand"/>
                </StackPanel>
            </DockPanel>

            <!-- Footer -->
            <TextBlock x:Name="FooterText" DockPanel.Dock="Bottom" Margin="4,10,4,0"
                       FontSize="11" Foreground="{StaticResource TextSecondary}"
                       Text="scanning…"/>

            <!-- Session list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="4,18"
                               HorizontalAlignment="Center" FontSize="12.5"
                               Foreground="{StaticResource TextSecondary}"
                               Text="No active Claude Code sessions"/>
                    <ItemsControl x:Name="SessionList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBg}" CornerRadius="8"
                                        Padding="10,8" Margin="0,0,0,6" Cursor="Hand"
                                        ToolTip="{Binding Tooltip}"
                                        MouseLeftButtonUp="OnSessionClick">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource CardBgHover}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource AccentBusy}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDormant}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>

                                        <!-- Status dot -->
                                        <Ellipse Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                                 Width="9" Height="9" Margin="0,0,10,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource AccentIdle}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusText}" Value="waiting">
                                                            <Setter Property="Fill" Value="#FF6C9DF2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDormant}" Value="True">
                                                            <Setter Property="Fill" Value="#FF6A6A7A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource AccentBusy}"/>
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard x:Name="PulseBoard">
                                                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                         From="1" To="0.25" Duration="0:0:0.7"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <StopStoryboard BeginStoryboardName="PulseBoard"/>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>

                                        <!-- Name + badge -->
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                            <Border Background="{StaticResource BadgeBg}" CornerRadius="3"
                                                    Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EntrypointBadge}" FontSize="9"
                                                           Foreground="{StaticResource TextSecondary}"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Elapsed -->
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Elapsed}"
                                                   FontSize="11.5" Foreground="{StaticResource TextSecondary}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>

                                        <!-- Detail line -->
                                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3,0,0"
                                                   FontSize="11" Foreground="{StaticResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding FolderLeaf, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ModelText, Mode=OneWay}"/>
                                        </TextBlock>

                                        <!-- Usage -->
                                        <TextBlock Grid.Row="1" Grid.Column="2" Margin="8,3,0,0"
                                                   Text="{Binding UsageText}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondary}"/>

                                        <!-- Git branch @ commit -->
                                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                                   Text="{Binding BranchText}" FontSize="11"
                                                   Foreground="#FF8FBCA8" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BranchText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <!-- Usage bars: context fill, then output volume -->
                                        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,7,0,1">
                                            <ProgressBar Style="{StaticResource ThinBar}"
                                                         Value="{Binding ContextPercent, Mode=OneWay}"
                                                         Foreground="{Binding CtxBarBrush}"
                                                         ToolTip="{Binding CtxBarTooltip}"/>
                                            <ProgressBar Style="{StaticResource ThinBar}" Margin="0,3,0,0"
                                                         Value="{Binding OutputPercent, Mode=OneWay}"
                                                         Foreground="{Binding OutBarBrush}"
                                                         ToolTip="{Binding OutBarTooltip}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
